rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eine Sammlung pro Strecke: scores_arta_s2, scores_luzern_s2, scores_space_s2 (Strecke + Saison)
    match /{collection}/{doc} {
      allow read: if collection.matches('scores_.*');
      allow create: if collection.matches('scores_.*')
        && request.resource.data.keys().hasOnly(['name','driver','stage','time','items','boosts','won','score','date','ts','avatar'])
        && request.resource.data.avatar is string && request.resource.data.avatar.size() >= 3 && request.resource.data.avatar.size() <= 16000
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 14
        && request.resource.data.driver in ['girl','boy','plane','rocket']
        && request.resource.data.stage is string && collection == 'scores_' + request.resource.data.stage
        && request.resource.data.time is number && request.resource.data.time >= 20 && request.resource.data.time <= 1000
        && request.resource.data.items is int && request.resource.data.items >= 0 && request.resource.data.items <= 200
        && request.resource.data.boosts is int && request.resource.data.boosts >= 0 && request.resource.data.boosts <= 100
        && request.resource.data.won is bool
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 30000;
      allow update: if false;
      // Alte Ergebnisse ohne Avatar dürfen aufgeräumt werden (neue haben immer einen)
      allow delete: if collection.matches('scores_.*') && (!('avatar' in resource.data) || resource.data.avatar == '');
    }
  }
}
